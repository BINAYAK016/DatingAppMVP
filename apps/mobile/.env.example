# Android Studio emulator reaches the host computer through 10.0.2.2.
EXPO_PUBLIC_API_URL=
# Empty web value uses the website's own origin (local export preview proxies API).
# For Metro web development, set http://localhost:4100 in the command's environment.
# iOS Simulator: http://localhost:4100
# Physical devices need an explicitly configured reachable, preferably HTTPS backend.
# Explicit opt-in for a local native build's HTTP transport exceptions:
SANGAI_ALLOW_LOCAL_HTTP=true
# Local testing only. Deployed builds should set false.
EXPO_PUBLIC_CONNECTION_SETTINGS=true
# Optional remote push, after configuring your own Expo project and FCM/APNs:
# EXPO_PUBLIC_EAS_PROJECT_ID=your-project-id
# Public OAuth client IDs only. Server GOOGLE_CLIENT_ID must match the web ID.
# Register Android com.sangai.beta with the actual signing SHA-1 in Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client for com.sangai.beta; app.config.ts derives its reversed URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

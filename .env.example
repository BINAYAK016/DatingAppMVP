# Local emulator beta only. Never deploy these values publicly.
POSTGRES_PASSWORD=local-beta-only
ENABLE_DEMO=true
ENABLE_PUSH=false
ENABLE_GAMES_V2=true
# Beta guardrails; retry responses include Retry-After. Tune with measured traffic.
MAX_UPLOAD_REQUESTS=4
MAX_UPLOAD_REQUESTS_PER_ACCOUNT=2
MAX_MEDIA_PROCESSING=2
MAX_MEDIA_PROCESSING_PER_ACCOUNT=1
ADMIN_KEY=local-beta-admin-change-me
# Local Mailpit captures verification/reset email at http://localhost:8025.
# Replace these for an invited real-tester environment; keep secrets out of Git.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sangai <beta@sangai.invalid>
GOOGLE_CLIENT_ID=
# Generate a random server-only value (at least 32 characters); never EXPO_PUBLIC.
OTP_HASH_SECRET=
# Additional approved web preview origins, comma-separated HTTPS origins.
CORS_ORIGINS=
